[Unit]
Description=Pulse Factory controller: one process that drives the seats of a run

[Service]
Type=simple
ExecStart=%h/.local/bin/pulse-factory controller
Restart=on-failure
RestartSec=5
# Seats run in session hosts, each in a transient user unit of its own, outside this unit's cgroup,
# so a stop or a restart of the controller leaves them running (ADR-0001's amendment, `r2.s2.w3`).
# The chat processes are still children of the controller until `r2.s2.w5`: a stop ends every process
# left in the unit's cgroup, such as a background command that a chat started in its own session
# (ADR-0001, ADR-0015). So the kill mode stays.
KillMode=control-group
# The launcher of the session hosts: systemd starts each one as a unit. Unset, the controller uses
# the detached launcher, which a fenced seat or a test uses (`docs/install.md`).
Environment=PF_HOST_LAUNCHER=systemd
# Seats inherit this environment. `gh` and `git` take their credentials from the operator's home.
Environment=PATH=%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
# The operator turns the network API on here: PF_API_LISTEN=<tailnet address>:<port> (ADR-0012). The
# leading `-` makes the file optional. With no file or no address, the API is off.
EnvironmentFile=-%h/.config/pulse-factory/controller.env

[Install]
WantedBy=default.target
